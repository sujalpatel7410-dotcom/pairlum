# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Pairlum's shared backend. Create a
# free project at https://supabase.com, then:
#   1. Open the SQL editor and run supabase/schema.sql from this repo once.
#   2. Go to Project Settings -> API and copy the "Project URL" into
#      VITE_SUPABASE_URL, and the "anon public" key into VITE_SUPABASE_ANON_KEY.
# Without these, the app shows a "backend not configured" screen instead of the
# login/sign-up flow.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# VITE_N8N_WEBHOOK_URL: Production webhook URL from the n8n workflow in
# n8n/pairlum-notifications.workflow.json (import it, activate it, then copy the
# "Production URL" from its Webhook node). Leave unset to disable notifications —
# the app skips the call silently when this isn't configured.
VITE_N8N_WEBHOOK_URL=""

# VITE_CLOUDINARY_CLOUD_NAME / VITE_CLOUDINARY_UPLOAD_PRESET: Pairlum has no
# custom upload server, so photo/video uploads go straight from the browser to
# Cloudinary using an UNSIGNED upload preset. To set this up:
#   1. Create a free account at https://cloudinary.com and open the Dashboard —
#      copy your "Cloud name" into VITE_CLOUDINARY_CLOUD_NAME below.
#   2. Go to Settings → Upload → Upload presets → Add upload preset.
#   3. Set "Signing Mode" to "Unsigned", give it a name (e.g. "pairlum_unsigned"),
#      save, and put that name in VITE_CLOUDINARY_UPLOAD_PRESET below.
# Leave both unset to disable uploads — the upload buttons show a friendly error.
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
