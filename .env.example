# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Pairlum's backend — accounts,
# Couple Spaces, and shared/synced data (see supabase/schema.sql). Create a
# project at https://supabase.com, run supabase/schema.sql in its SQL Editor
# (Project -> SQL Editor -> New query), then copy Project Settings -> API ->
# Project URL and the "anon" "public" key below (never the service_role key —
# that one is server-only and must never ship in a browser build).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_N8N_WEBHOOK_URL: Production webhook URL from the n8n workflow in
# n8n/pairlum-notifications.workflow.json (import it, activate it, then copy the
# "Production URL" from its Webhook node). Leave unset to disable notifications —
# the app skips the call silently when this isn't configured.
VITE_N8N_WEBHOOK_URL=""

# VITE_CLOUDINARY_CLOUD_NAME / VITE_CLOUDINARY_UPLOAD_PRESET: Pairlum has no
# backend, so photo/video uploads go straight from the browser to Cloudinary
# using an UNSIGNED upload preset. To set this up:
#   1. Create a free account at https://cloudinary.com and open the Dashboard —
#      copy your "Cloud name" into VITE_CLOUDINARY_CLOUD_NAME below.
#   2. Go to Settings → Upload → Upload presets → Add upload preset.
#   3. Set "Signing Mode" to "Unsigned", give it a name (e.g. "pairlum_unsigned"),
#      save, and put that name in VITE_CLOUDINARY_UPLOAD_PRESET below.
# Leave both unset to disable uploads — the upload buttons show a friendly error.
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
